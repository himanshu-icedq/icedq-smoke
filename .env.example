# Copy to .env and fill in values. .env is gitignored — never commit secrets.

# iceDQ UI login (all smoke scripts)
ICEDQ_URL=https://HOST:32222
ICEDQ_USER=admin
ICEDQ_PASS=

# smoke.mjs Oracle connection (also used by catalog entry 15-oracle-up)
ICEDQ_DB_HOST=192.168.100.126
ICEDQ_DB_PORT=1521
ICEDQ_DB_NAME=orcl
ICEDQ_DB_USER=regression_database
ICEDQ_DB_PASS=

# smoke-connections.mjs — one password env var per catalog entry (lib/connections-catalog.mjs)
ICEDQ_CONN_05_DB2_PASS=
ICEDQ_CONN_08_GREENPLUM_PASS=
ICEDQ_CONN_10_DENODO_PASS=
ICEDQ_CONN_14_MYSQL_PASS=
ICEDQ_CONN_16_POSTGRESQL_PASS=
ICEDQ_CONN_24_CLICKHOUSE_PASS=
